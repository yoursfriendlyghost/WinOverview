// WinOverview UI: the overview panel, the snap picker and the Settings window.
// All positions are worked out in Rust (src/layout.rs) and passed in as x/y/w/h.

import { LineEdit, SpinBox, CheckBox, Button, Slider, ScrollView, Palette as StdPalette } from "std-widgets.slint";

import { Theme, Palette, CloseDot, Chip, Glyph, RoundButton } from "common.slint";
import { WidgetState, WidgetCard, NoteItem, CalDay } from "widgets.slint";
export { Theme, WidgetState, NoteItem, CalDay }

export struct AppItem {
    id: int,           // window handle
    title: string,
    icon: image,
    hit: bool,         // matches the search (always true when not searching)
    live: bool,        // a live preview is drawn over this cell (previews view)
    private: bool,     // privacy mode: no preview, no window title
    count: int,        // windows in this cell (more than 1 = a stack of the same app)
    x: length, y: length, w: length, h: length,   // inside the tile
}

export struct DeskItem {
    index: int,
    x: length, y: length, w: length, h: length,
    current: bool,
    apps: [AppItem],
    more: int,         // apps that didn't fit (previews view)
    more-x: length, more-y: length, more-w: length, more-h: length,
}

export struct Zone { x: float, y: float, w: float, h: float }
export struct SnapLayout { zones: [Zone] }
export struct ThemeChoice { name: string, panel: color, tile: color, text: color }
export struct WidgetSlot { kind: int, x: length, y: length, w: length, h: length }
export struct WidgetFlags { notes: bool, music: bool, timer: bool, weather: bool, calendar: bool }
export struct PrivacyApp { name: string, icon: image, on: bool }

export component Overview inherits Window {
    title: "WinOverview";
    no-frame: true;
    always-on-top: true;
    background: Palette.t.panel;
    width: panel-w;
    height: panel-h;
    forward-focus: keys;

    in property <Theme> theme: Palette.t;
    in property <color> accent: Palette.accent;
    changed theme => { Palette.t = self.theme; }
    changed accent => { Palette.accent = self.accent; }

    in property <length> panel-w: 400px;
    in property <length> panel-h: 200px;
    in property <[DeskItem]> desks;
    in property <length> plus-x; in property <length> plus-y;
    in property <length> plus-w; in property <length> plus-h;
    in property <bool> previews: false;     // live previews view
    in property <bool> thumbs-on: false;    // live previews are currently drawn
    in property <int> selected-id: 0;
    in property <bool> shown: false;
    in-out property <string> query;          // the search text (typed into the search box)
    in property <int> matches: 0;           // apps matching the search
    in property <bool> can-close-desk: true;
    in property <bool> single: false;       // one grid of every window: no desktops to show

    in-out property <bool> dragging: false;
    in-out property <int> desk-drag: -1;     // desktop being dragged (-1: none)
    in-out property <int> drag-id: 0;
    in-out property <image> drag-icon;
    in-out property <length> drag-x;
    in-out property <length> drag-y;

    callback desk-clicked(int);
    callback desk-close(int);
    callback app-clicked(int);
    callback app-close(int);
    callback app-private(int);       // right-click: hide / show this app's preview
    callback app-hover(int, bool, length, length, length, length);   // id, entered, cell rect in the window
    callback drag-started(int);
    callback app-dropped(int, length, length);
    callback add-clicked();
    callback desk-dropped(int, length, length);   // desktop, where it was dropped
    callback key-pressed(string, bool, bool) -> bool;   // text, ctrl, shift; true = handled
    callback search-edited(string);

    // widgets
    in property <[WidgetSlot]> widget-slots;

    // edit mode: move the panel, pick the orientation and widgets
    in property <bool> edit-mode: false;
    in property <bool> custom-position: false;
    callback edit-start();
    callback edit-drag(int);         // moving the panel: 0 = pressed, 1 = mouse moved, 2 = released
    callback edit-reset();
    callback edit-done();
    // edit mode, widgets inside the panel: drag one onto another's place to move it there
    in-out property <int> widget-drag: -1;
    in-out property <length> widget-drag-x;
    in-out property <length> widget-drag-y;
    callback widget-moved(int, length, length);   // which (its index), where it was dropped

    public function focus-keys() { search.focus(); }

    // Search capsule width (measured from the text)
    measure := Text { text: root.query; font-size: 14px; font-weight: 600; visible: false; }
    property <length> cap-w: min(root.panel-w - 28px, max(240px, measure.preferred-width + 96px));

    // Everything fades and slides in when opened
    content := Rectangle {
        opacity: root.shown ? 1 : 0;
        y: root.shown ? 0 : -6px;
        animate opacity { duration: 140ms; easing: ease-out; }
        animate y { duration: 180ms; easing: ease-out; }

        // ---- desktop tiles ----
        for d in root.desks: Rectangle {
            property <bool> under-pointer: root.drag-x >= d.x && root.drag-x < d.x + d.w
                && root.drag-y >= d.y && root.drag-y < d.y + d.h;
            // an app or another desktop is being dragged over this one
            property <bool> target: self.under-pointer
                && !root.single && (root.dragging || (root.desk-drag >= 0 && root.desk-drag != d.index));
            opacity: root.desk-drag == d.index ? 0.35 : 1;
            animate opacity { duration: 120ms; }

            x: d.x; y: d.y; width: d.w; height: d.h;
            animate x, y, width, height { duration: 160ms; easing: ease-out; }
            border-radius: 12px;
            background: self.target ? Palette.accent.with-alpha(0.16)
                      : d.current ? Palette.t.tile-current
                      : tile.has-hover ? Palette.t.tile-hover : Palette.t.tile;
            border-width: self.target || d.current ? 1.5px : 1px;
            border-color: self.target ? Palette.accent
                        : d.current ? Palette.accent.with-alpha(0.55)
                        : Palette.t.border;
            animate background, border-color { duration: 120ms; }

            tile := TouchArea {
                property <bool> did-drag: false;
                mouse-cursor: root.single ? MouseCursor.default : MouseCursor.pointer;
                // drag a desktop onto another one to move it there
                pointer-event(e) => {
                    if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                        self.did-drag = false;
                    }
                    if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up
                        && root.desk-drag == d.index) {
                        root.desk-drag = -1;
                        root.desk-dropped(d.index, root.drag-x, root.drag-y);
                    }
                }
                moved => {
                    if (self.pressed && root.desk-drag < 0 && !root.dragging && !root.edit-mode && !root.single
                        && (abs(self.mouse-x - self.pressed-x) > 8px || abs(self.mouse-y - self.pressed-y) > 8px)) {
                        self.did-drag = true;
                        root.desk-drag = d.index;
                    }
                    if (root.desk-drag == d.index) {
                        root.drag-x = self.absolute-position.x + self.mouse-x;
                        root.drag-y = self.absolute-position.y + self.mouse-y;
                    }
                }
                clicked => { if (!self.did-drag) { root.desk-clicked(d.index); } }

                // number pill
                if !root.single: Rectangle {
                    x: 10px; y: 9px; height: 18px;
                    width: max(18px, num.preferred-width + 12px);
                    border-radius: 9px;
                    background: d.current ? Palette.accent : Palette.t.pill;
                    num := Text {
                        text: d.index + 1;
                        color: d.current ? #111216 : Palette.t.text;
                        font-size: 11px; font-weight: 700;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                }

                if d.apps.length == 0: Text {
                    x: 0; y: 34px; width: parent.width; height: parent.height - 40px;
                    text: "Empty"; color: Palette.t.faint; font-size: 12px;
                    horizontal-alignment: center; vertical-alignment: center;
                }

                // apps
                for a in d.apps: Rectangle {
                    property <bool> selected: a.id == root.selected-id;
                    x: a.x; y: a.y; width: a.w; height: a.h;
                    border-radius: root.previews ? 9px : 11px;
                    background: self.selected ? Palette.accent.with-alpha(0.25)
                              : cell.has-hover ? Palette.t.cell-hover : Palette.t.cell;
                    border-width: self.selected ? 2px : (root.previews && cell.has-hover ? 1px : 0px);
                    border-color: self.selected ? Palette.accent : Palette.t.border;
                    opacity: (root.dragging && root.drag-id == a.id) ? 0.25 : (a.hit ? 1 : 0.22);
                    animate background, opacity { duration: 110ms; }

                    // a stack: the edges of the cards underneath peek out at the top
                    if a.count > 2: Rectangle {
                        x: 12px; y: -6px; width: parent.width - 24px; height: 3px;
                        border-top-left-radius: 3px; border-top-right-radius: 3px;
                        background: Palette.t.pill;
                    }
                    if a.count > 1: Rectangle {
                        x: 6px; y: -3px; width: parent.width - 12px; height: 3px;
                        border-top-left-radius: 3px; border-top-right-radius: 3px;
                        background: Palette.t.cell-hover;
                    }

                    cell := TouchArea {
                        property <bool> did-drag: false;
                        mouse-cursor: pointer;

                        changed has-hover => {
                            root.app-hover(a.id, self.has-hover,
                                self.absolute-position.x, self.absolute-position.y, self.width, self.height);
                        }
                        pointer-event(e) => {
                            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                                self.did-drag = false;
                            }
                            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                                root.app-private(a.id);
                            }
                            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up
                                && root.dragging && root.drag-id == a.id) {
                                root.dragging = false;
                                root.app-dropped(a.id, root.drag-x, root.drag-y);
                            }
                        }
                        moved => {
                            if (self.pressed && !root.dragging
                                && (abs(self.mouse-x - self.pressed-x) > 6px || abs(self.mouse-y - self.pressed-y) > 6px)) {
                                self.did-drag = true;
                                root.drag-id = a.id;
                                root.drag-icon = a.icon;
                                root.dragging = true;
                                root.drag-started(a.id);
                            }
                            if (root.dragging && root.drag-id == a.id) {
                                root.drag-x = self.absolute-position.x + self.mouse-x;
                                root.drag-y = self.absolute-position.y + self.mouse-y;
                            }
                        }
                        clicked => { if (!self.did-drag) { root.app-clicked(a.id); } }

                        // Icons view: just the icon
                        if !root.previews: Image {
                            x: (parent.width - 32px) / 2; y: (parent.height - 32px) / 2;
                            width: 32px; height: 32px;
                            source: a.icon;
                            image-rendering: smooth;
                        }
                        // × closes the window (or every window of a stack)
                        if !root.previews && cell.has-hover && !root.dragging: CloseDot {
                            x: parent.width - 13px; y: -5px;
                            clicked => { root.app-close(a.id); }
                        }

                        // Previews view: title strip; the live preview is drawn below it by Windows
                        if root.previews: Image {
                            x: 6px; y: 4px; width: 14px; height: 14px;
                            source: a.icon;
                            image-rendering: smooth;
                        }
                        // clipped: right-to-left titles (Arabic, Hebrew) can draw past their box
                        if root.previews: Rectangle {
                            x: 25px; y: 2px; width: parent.width - 50px; height: 18px;
                            clip: true;
                            Text {
                                width: parent.width; height: parent.height;
                                text: a.title;
                                color: Palette.t.text; font-size: 11px;
                                overflow: elide; vertical-alignment: center;
                            }
                        }
                        if root.previews && !(a.live && root.thumbs-on): Image {
                            property <length> s: max(min(40px, parent.height - 34px), min(parent.height * 0.3, 96px));
                            x: (parent.width - self.s) / 2; y: 22px + (parent.height - 22px - self.s) / 2;
                            width: self.s; height: self.s;
                            source: a.icon;
                            image-rendering: smooth;
                        }
                        // how many windows are in the stack
                        // (in previews it makes way for the × while you're over the cell)
                        if a.count > 1 && !(root.previews && cell.has-hover && !root.dragging): Rectangle {
                            x: root.previews ? parent.width - self.width - 6px : parent.width - self.width + 5px;
                            y: root.previews ? 3px : parent.height - 11px;
                            height: 16px; width: max(16px, badge.preferred-width + 10px);
                            border-radius: 8px;
                            background: Palette.accent;
                            badge := Text {
                                text: a.count;
                                color: #111216; font-size: 10px; font-weight: 700;
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                        }

                        // privacy mode: a small lock instead of the preview
                        if a.private && !root.previews: Rectangle {
                            x: parent.width - 17px; y: parent.height - 17px;
                            width: 16px; height: 16px; border-radius: 8px;
                            background: Palette.t.panel;
                            Glyph { name: "lock"; width: 10px; height: 10px; tint: Palette.t.faint; }
                        }
                        if a.private && root.previews: Rectangle {
                            x: (parent.width - 18px) / 2; y: parent.height - 26px;
                            width: 18px; height: 18px;
                            Glyph { name: "lock"; width: 12px; height: 12px; tint: Palette.t.faint; }
                        }
                        if root.previews && cell.has-hover && !root.dragging: CloseDot {
                            size: 16px;
                            x: parent.width - 19px; y: 3px;
                            clicked => { root.app-close(a.id); }
                        }
                    }
                }

                // "+N more" (previews view)
                if d.more > 0: Rectangle {
                    x: d.more-x; y: d.more-y; width: d.more-w; height: d.more-h;
                    border-radius: 9px;
                    background: Palette.t.cell;
                    Text {
                        text: "+" + d.more;
                        color: Palette.t.text; font-size: 18px; font-weight: 600;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                }

                if tile.has-hover && root.can-close-desk && !root.dragging && !root.single: CloseDot {
                    x: parent.width - 26px; y: 8px;
                    clicked => { root.desk-close(d.index); }
                }
            }
        }

        // ---- "+" new desktop ----
        if !root.single: Rectangle {
            property <bool> target: root.dragging
                && root.drag-x >= root.plus-x && root.drag-x < root.plus-x + root.plus-w
                && root.drag-y >= root.plus-y && root.drag-y < root.plus-y + root.plus-h;
            x: root.plus-x; y: root.plus-y; width: root.plus-w; height: root.plus-h;
            animate x, y, height { duration: 160ms; easing: ease-out; }
            border-radius: 12px;
            background: self.target ? Palette.accent.with-alpha(0.16) : plus.has-hover ? Palette.t.tile-hover : transparent;
            border-width: 1.5px;
            border-color: self.target ? Palette.accent : Palette.t.border;
            animate background, border-color { duration: 120ms; }
            Text {
                text: root.plus-w > 140px ? "+   New desktop" : "+";
                color: parent.target ? Palette.accent : Palette.t.faint;
                font-size: root.plus-w > 140px ? 13px : 26px;
                horizontal-alignment: center; vertical-alignment: center;
            }
            plus := TouchArea { mouse-cursor: pointer; clicked => { root.add-clicked(); } }
        }

        // ---- widgets ----
        for w[wi] in root.widget-slots: WidgetCard {
            x: w.x; y: w.y; width: w.w; height: w.h;
            opacity: root.widget-drag == wi ? 0.3 : 1;
            animate x, y { duration: 160ms; easing: ease-out; }
            kind: w.kind;
            escape => { root.focus-keys(); }
        }

        // ---- bottom line: what you're searching for, and the edit button ----
        if !root.edit-mode: RoundButton {
            x: root.panel-w - 34px; y: root.panel-h - 29px;
            glyph: "edit"; size: 24px;
            opacity: self.has-hover ? 1 : 0.45;
            clicked => { root.edit-start(); }
        }
        // ---- search: a capsule at the top while you type (the text box itself is below) ----
        if root.query != "": Rectangle {
            x: (root.panel-w - root.cap-w) / 2; y: 12px;
            width: root.cap-w; height: 32px;
            border-radius: 16px;
            background: Palette.accent;
            drop-shadow-blur: 10px; drop-shadow-color: Palette.accent.with-alpha(0.35);
            Glyph { x: 14px; name: "search"; width: 14px; height: 14px; tint: #111216; }
            Text {
                x: parent.width - 52px; width: 40px; height: parent.height;
                text: root.matches == 0 ? "none" : root.matches;
                color: #111216.with-alpha(0.6); font-size: 12px;
                horizontal-alignment: right; vertical-alignment: center;
            }
        }
    }

    // The search box. It always has the keyboard, so typing anywhere starts a search; it sits
    // off-screen until there's text. Keys that move around the panel are taken before it sees them
    // (capture-key-pressed); the rest edit the text like any text box (Home, End, Ctrl+arrows,
    // Shift+arrows, Ctrl+A, Ctrl+Backspace, Ctrl+C/V/X...).
    keys := FocusScope {
        // a 1-pixel spot in the corner until there's text (it has to stay on screen to keep focus)
        x: root.query != "" ? (root.panel-w - root.cap-w) / 2 : 0;
        y: root.query != "" ? 12px : 0;
        width: root.query != "" ? root.cap-w : 1px;
        height: root.query != "" ? 32px : 1px;
        capture-key-pressed(e) => {
            if (root.key-pressed(e.text, e.modifiers.control, e.modifiers.shift)) { return accept; }
            return reject;
        }
        search := TextInput {
            x: root.query != "" ? 38px : 0; width: max(1px, parent.width - 96px); height: parent.height;
            text <=> root.query;
            single-line: true;
            color: root.query != "" ? #111216 : transparent;
            font-size: 14px; font-weight: 600;
            vertical-alignment: center;
            selection-background-color: #111216.with-alpha(0.3);
            selection-foreground-color: #111216;
            edited => { root.search-edited(self.text); }
        }
    }

    // ---- edit mode: the whole panel is a handle, plus a toolbar at the top ----
    if root.edit-mode: TouchArea {
        y: 46px; height: parent.height - 46px;
        mouse-cursor: move;
        pointer-event(e) => {
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) { root.edit-drag(0); }
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) { root.edit-drag(2); }
        }
        moved => { if (self.pressed) { root.edit-drag(1); } }
    }
    if root.edit-mode: Rectangle {
        border-width: 2px; border-color: Palette.accent;
        border-radius: 8px;
    }
    // edit mode: each widget is a handle of its own; drop it on another widget to swap places
    if root.edit-mode: Rectangle {
        for w[wi] in root.widget-slots: Rectangle {
            property <bool> target: root.widget-drag >= 0 && root.widget-drag != wi
                && root.widget-drag-x >= w.x && root.widget-drag-x < w.x + w.w
                && root.widget-drag-y >= w.y && root.widget-drag-y < w.y + w.h;
            x: w.x; y: w.y; width: w.w; height: w.h;
            border-radius: 14px;
            border-width: self.target ? 2px : (wta.has-hover && root.widget-drag < 0 ? 1.5px : 0px);
            border-color: Palette.accent;
            background: self.target ? Palette.accent.with-alpha(0.14) : transparent;
            wta := TouchArea {
                mouse-cursor: MouseCursor.grab;
                moved => {
                    if (self.pressed) {
                        root.widget-drag = wi;
                        root.widget-drag-x = w.x + self.mouse-x;
                        root.widget-drag-y = w.y + self.mouse-y;
                    }
                }
                pointer-event(e) => {
                    if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up && root.widget-drag == wi) {
                        root.widget-drag = -1;
                        root.widget-moved(wi, root.widget-drag-x, root.widget-drag-y);
                    }
                }
            }
        }
        // the one being moved follows the pointer
        for w[wi] in root.widget-slots: Rectangle {
            visible: root.widget-drag == wi;
            x: root.widget-drag-x - w.w / 2; y: root.widget-drag-y - w.h / 2;
            width: w.w; height: w.h;
            border-radius: 14px;
            background: Palette.t.panel.with-alpha(0.92);
            border-width: 2px; border-color: Palette.accent;
            drop-shadow-blur: 16px; drop-shadow-color: #00000060;
            Text {
                text: w.kind == 0 ? "Notes" : w.kind == 1 ? "Music" : w.kind == 2 ? "Timer" : w.kind == 3 ? "Weather" : "Calendar";
                color: Palette.t.text; font-size: 14px; font-weight: 600;
                horizontal-alignment: center; vertical-alignment: center;
            }
        }
    }
    if root.edit-mode: Rectangle {
        x: 0; y: 0; width: parent.width; height: 46px;
        background: Palette.t.tile-current;
        TouchArea { }   // not a drag area: just the buttons
        HorizontalLayout {
            padding-left: 14px; padding-right: 10px;
            padding-top: 10px; padding-bottom: 10px;
            spacing: 6px;
            Text { text: "Edit layout"; color: Palette.t.text; font-size: 13px; font-weight: 600; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            if root.custom-position: Chip { text: "Reset"; clicked => { root.edit-reset(); } }
            Chip { text: "Done"; on: true; clicked => { root.edit-done(); } }
        }
    }

    // desktop following the mouse while it's dragged
    if root.desk-drag >= 0: Rectangle {
        x: root.drag-x - 28px; y: root.drag-y - 20px;
        width: 56px; height: 40px;
        border-radius: 10px;
        background: Palette.t.panel;
        border-width: 1.5px; border-color: Palette.accent;
        drop-shadow-blur: 12px; drop-shadow-color: #00000080;
        Rectangle {
            width: 22px; height: 22px; border-radius: 11px;
            background: Palette.accent;
            Text { text: root.desk-drag + 1; color: #111216; font-size: 12px; font-weight: 700;
                   horizontal-alignment: center; vertical-alignment: center; }
        }
    }

    // icon following the mouse while dragging
    if root.dragging: Rectangle {
        x: root.drag-x - 24px; y: root.drag-y - 24px;
        width: 48px; height: 48px;
        border-radius: 12px;
        background: Palette.t.panel;
        border-width: 1.5px; border-color: Palette.accent;
        drop-shadow-blur: 12px; drop-shadow-color: #00000080;
        Image { x: 8px; y: 8px; width: 32px; height: 32px; source: root.drag-icon; }
    }
}

// ================= A capsule of widgets (Free layout) =================
// One or more widgets that sit and move together. Sizes must match src/free.rs.

export component WidgetWindow inherits Window {
    title: "";
    no-frame: true;
    always-on-top: true;
    background: Palette.t.panel;

    in property <Theme> theme: Palette.t;
    in property <color> accent: Palette.accent;
    changed theme => { Palette.t = self.theme; }
    changed accent => { Palette.accent = self.accent; }

    in property <[int]> kinds;              // widgets in this capsule, in order
    in property <bool> vertical: false;     // stacked instead of side by side
    in property <bool> edit-mode: false;
    in property <bool> shown: false;
    in property <length> card-w: 248px;
    in property <length> card-h: 156px;
    callback edit-drag(int);                // moving the capsule: 0 = pressed, 1 = moved, 2 = released
    callback join();                        // merge with the nearest capsule
    callback split();                       // one capsule per widget
    callback rotate();                      // side by side <-> stacked

    property <length> pad: 8px;
    property <length> gap: 8px;
    property <length> head: root.edit-mode ? 36px : 0px;
    property <int> n: max(1, root.kinds.length);

    width: root.pad * 2 + (root.vertical ? root.card-w : root.n * root.card-w + (root.n - 1) * root.gap);
    height: root.head + root.pad * 2 + (root.vertical ? root.n * root.card-h + (root.n - 1) * root.gap : root.card-h);

    for k[i] in root.kinds: WidgetCard {
        x: root.pad + (root.vertical ? 0px : i * (root.card-w + root.gap));
        y: root.head + root.pad + (root.vertical ? i * (root.card-h + root.gap) : 0px) + (root.shown ? 0px : -6px);
        width: root.card-w; height: root.card-h;
        opacity: root.shown ? 1 : 0;
        animate opacity { duration: 140ms; easing: ease-out; }
        animate y { duration: 180ms; easing: ease-out; }
        kind: k;
    }

    // edit mode: a handle bar on top (the widgets below stay usable)
    if root.edit-mode: Rectangle {
        x: 0; y: 0; width: parent.width; height: root.head;
        background: Palette.t.tile-current;
        HorizontalLayout {
            padding-left: 6px; padding-right: 6px; padding-top: 5px; padding-bottom: 5px;
            spacing: 4px;
            handle := Rectangle {
                horizontal-stretch: 1;
                border-radius: 6px;
                background: grip.has-hover ? Palette.t.cell-hover : transparent;
                // grip dots
                HorizontalLayout {
                    x: 8px; width: 24px; spacing: 3px; alignment: start;
                    for i in 3: Rectangle { width: 4px; height: 4px; y: (parent.height - 4px) / 2;
                                            border-radius: 2px; background: Palette.t.faint; }
                }
                grip := TouchArea {
                    mouse-cursor: move;
                    pointer-event(e) => {
                        if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) { root.edit-drag(0); }
                        if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) { root.edit-drag(2); }
                    }
                    moved => { if (self.pressed) { root.edit-drag(1); } }
                }
            }
            Chip { text: "Join"; font-size: 11px; clicked => { root.join(); } }
            if root.n > 1: Chip { text: root.vertical ? "Side by side" : "Stack"; font-size: 11px; clicked => { root.rotate(); } }
            if root.n > 1: Chip { text: "Split"; font-size: 11px; clicked => { root.split(); } }
        }
    }
    if root.edit-mode: Rectangle {
        border-width: 2px; border-color: Palette.accent;
        border-radius: 8px;
    }
}

// ================= Snap picker =================

// One stack's windows (same app, same desktop), in their own window over the panel.
// Cell positions come from src/stack.rs; live previews are drawn under each title strip by Windows.
export component StackView inherits Window {
    title: "WinOverview - stack";
    no-frame: true;
    always-on-top: true;
    background: Palette.t.panel;
    forward-focus: fs;
    width: view-w;
    height: view-h;

    in property <Theme> theme: Palette.t;
    in property <color> accent: Palette.accent;
    changed theme => { Palette.t = self.theme; }
    changed accent => { Palette.accent = self.accent; }

    in property <length> view-w: 400px;
    in property <length> view-h: 300px;
    in property <image> app-icon;
    in property <string> heading;
    in property <[AppItem]> items;
    in property <bool> shown;
    in property <bool> thumbs-on;
    in-out property <int> selected: 0;      // index of the highlighted window

    callback pick(int);          // window handle
    callback close-window(int);  // window handle
    callback dismiss();
    callback key(string) -> bool;

    public function focus-keys() { fs.focus(); }

    fs := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) { root.dismiss(); return accept; }
            if (root.key(e.text)) { return accept; }
            return reject;
        }
    }

    content := Rectangle {
        opacity: root.shown ? 1 : 0;
        animate opacity { duration: 130ms; easing: ease-out; }

        // header: icon, "App · N windows", close
        Image {
            x: 16px; y: 14px; width: 18px; height: 18px;
            source: root.app-icon;
            image-rendering: smooth;
        }
        Text {
            x: 42px; y: 12px; width: root.view-w - 90px; height: 22px;
            text: root.heading;
            color: Palette.t.text; font-size: 13px; font-weight: 600;
            overflow: elide; vertical-alignment: center;
        }
        CloseDot {
            x: root.view-w - 30px; y: 14px;
            clicked => { root.dismiss(); }
        }

        for a[i] in root.items: Rectangle {
            property <bool> sel: i == root.selected;
            x: a.x; y: a.y; width: a.w; height: a.h;
            border-radius: 9px;
            background: self.sel ? Palette.accent.with-alpha(0.25)
                      : cell.has-hover ? Palette.t.cell-hover : Palette.t.cell;
            border-width: self.sel ? 2px : (cell.has-hover ? 1px : 0px);
            border-color: self.sel ? Palette.accent : Palette.t.border;
            animate background { duration: 110ms; }

            cell := TouchArea {
                mouse-cursor: pointer;
                changed has-hover => { if (self.has-hover) { root.selected = i; } }
                clicked => { root.pick(a.id); }

                Image {
                    x: 6px; y: 4px; width: 14px; height: 14px;
                    source: a.icon;
                    image-rendering: smooth;
                }
                Rectangle {
                    x: 25px; y: 2px; width: parent.width - 50px; height: 18px;
                    clip: true;
                    Text {
                        width: parent.width; height: parent.height;
                        text: a.title;
                        color: Palette.t.text; font-size: 11px;
                        overflow: elide; vertical-alignment: center;
                    }
                }
                if !(a.live && root.thumbs-on): Image {
                    property <length> s: max(min(40px, parent.height - 34px), min(parent.height * 0.3, 96px));
                    x: (parent.width - self.s) / 2; y: 22px + (parent.height - 22px - self.s) / 2;
                    width: self.s; height: self.s;
                    source: a.icon;
                    image-rendering: smooth;
                }
                if a.private: Rectangle {
                    x: (parent.width - 18px) / 2; y: parent.height - 26px;
                    width: 18px; height: 18px;
                    Glyph { name: "lock"; width: 12px; height: 12px; tint: Palette.t.faint; }
                }
                if cell.has-hover: CloseDot {
                    size: 16px;
                    x: parent.width - 19px; y: 3px;
                    clicked => { root.close-window(a.id); }
                }
            }
        }
    }
}

export component SnapPicker inherits Window {
    title: "WinOverview - snap";
    no-frame: true;
    always-on-top: true;
    background: Palette.t.panel;
    forward-focus: fs;

    in property <Theme> theme: Palette.t;
    in property <color> accent: Palette.accent;
    changed theme => { Palette.t = self.theme; }
    changed accent => { Palette.accent = self.accent; }

    in property <image> app-icon;
    in property <string> name;
    in property <bool> has-partner;
    in property <image> partner-icon;
    in property <string> partner-name;
    in property <[SnapLayout]> layouts;
    in property <bool> shown;

    callback pick(int, float, float);   // layout, where in it (0..1, 0..1)
    callback dismiss();

    property <length> card-w: 138px;
    property <length> card-h: 88px;
    property <length> gap: 8px;

    width: 3 * card-w + 2 * gap + 28px;
    height: 70px + ceil(layouts.length / 3) * (card-h + gap) - gap + 14px;

    fs := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) { root.dismiss(); return accept; }
            return reject;
        }
    }

    // header: "<App>  +  <previous app>"
    HorizontalLayout {
        x: 14px; y: 12px; width: parent.width - 28px; height: 24px;
        spacing: 8px;
        Image { source: root.app-icon; width: 22px; height: 22px; }
        Text { text: root.name; color: Palette.t.text; font-size: 13px; font-weight: 600;
               vertical-alignment: center; overflow: elide; max-width: 150px; }
        if root.has-partner: Text { text: "+"; color: Palette.t.faint; font-size: 13px; vertical-alignment: center; }
        if root.has-partner: Image { source: root.partner-icon; width: 22px; height: 22px; }
        if root.has-partner: Text { text: root.partner-name; color: Palette.t.faint; font-size: 13px;
                                     vertical-alignment: center; overflow: elide; max-width: 150px; }
        Rectangle { horizontal-stretch: 1; }
    }
    Text {
        x: 14px; y: 40px; height: 18px;
        text: root.has-partner ? "Pick a spot - the other app fills the rest" : "Pick a spot";
        color: Palette.t.faint; font-size: 11px;
    }

    for l[li] in root.layouts: card := Rectangle {
        pure function zin(z: Zone) -> bool {
            return pick-area.has-hover
                && pick-area.mouse-x >= z.x * pick-area.width && pick-area.mouse-x < (z.x + z.w) * pick-area.width
                && pick-area.mouse-y >= z.y * pick-area.height && pick-area.mouse-y < (z.y + z.h) * pick-area.height;
        }
        property <int> partner-index: self.zin(l.zones[0]) ? 1 : 0;

        x: 14px + mod(li, 3) * (root.card-w + root.gap);
        y: 64px + floor(li / 3) * (root.card-h + root.gap) + (root.shown ? 0 : 8px);
        width: root.card-w; height: root.card-h;
        opacity: root.shown ? 1 : 0;
        animate opacity, y { duration: 200ms; delay: li * 22ms; easing: ease-out; }
        border-radius: 10px;
        background: pick-area.has-hover ? Palette.t.cell-hover : Palette.t.cell;
        border-width: 1px;
        border-color: pick-area.has-hover ? Palette.accent.with-alpha(0.6) : transparent;

        pick-area := TouchArea {
            x: 6px; y: 6px; width: parent.width - 12px; height: parent.height - 12px;
            mouse-cursor: pointer;
            clicked => { root.pick(li, self.mouse-x / self.width, self.mouse-y / self.height); }

            for z[zi] in l.zones: zr := Rectangle {
                property <bool> me: card.zin(z);
                property <bool> partner: root.has-partner && pick-area.has-hover && !self.me
                    && l.zones.length > 1 && zi == card.partner-index;
                x: z.x * parent.width + 2px; y: z.y * parent.height + 2px;
                width: z.w * parent.width - 4px; height: z.h * parent.height - 4px;
                border-radius: 5px;
                background: self.me ? Palette.accent : self.partner ? Palette.accent.with-alpha(0.4) : Palette.t.pill;
                animate background { duration: 90ms; }
                if zr.me || zr.partner: Image {
                    width: 16px; height: 16px;
                    source: zr.me ? root.app-icon : root.partner-icon;
                }
            }
        }
    }
}

// ================= Settings =================

component Row inherits HorizontalLayout {
    in property <string> label;
    in property <string> note;
    spacing: 12px;
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        Text { text: root.label; font-size: 14px; color: Palette.t.text; }
        if root.note != "": Text { text: root.note; font-size: 11px; color: Palette.t.faint; wrap: word-wrap; }
    }
    @children
}

component Heading inherits Text {
    font-size: 12px; font-weight: 600; color: Palette.t.faint;
}

export component Settings inherits Window {
    title: "WinOverview Settings";
    icon: @image-url("../assets/icon64.png");
    preferred-width: 540px;
    min-width: 480px;
    preferred-height: 820px;
    background: Palette.t.panel;

    // The colour theme (follows the theme you pick, before saving too)
    in property <Theme> look;      // set from Rust before the window is shown
    changed look => {
        Palette.t = self.look;
        StdPalette.color-scheme = self.look.dark ? ColorScheme.dark : ColorScheme.light;
    }
    callback theme-picked(string);

    // Version and updates
    in property <string> version;
    in property <string> update-status;
    in property <bool> update-error: false;
    in property <bool> update-ready: false;     // a newer version can be installed
    in property <bool> update-failed: false;    // installing failed: offer the release page
    in property <string> update-notes;
    callback check-updates();
    callback install-update();
    callback open-release();

    in-out property <string> hotkey: "Alt+`";
    in-out property <bool> previews: false;
    in-out property <bool> hover-preview: true;
    in-out property <int> per-row: 5;
    in-out property <int> top-margin: 10;
    in-out property <bool> mouse-monitor: true;
    in-out property <bool> startup: false;
    in-out property <color> accent: #8ab4f8;
    in-out property <string> theme: "Midnight";
    in property <[ThemeChoice]> themes;
    in-out property <bool> free-layout: false;     // widgets float in capsules
    in-out property <bool> vertical: false;        // desktops stacked
    in-out property <bool> widgets-first: false;
    in-out property <string> widget-size: "medium";
    in-out property <WidgetFlags> flags;
    in-out property <bool> privacy: false;
    in property <[PrivacyApp]> privacy-apps;
    in-out property <bool> one-desktop: false;     // one grid of every window
    in-out property <string> search-mode: "dim";   // "dim", "hide" or "top"
    callback privacy-toggle(int, bool);
    in-out property <string> city;
    in-out property <bool> fahrenheit: false;
    in property <bool> custom-position: false;
    callback edit-on-screen();
    callback reset-position();
    in property <string> status;
    in property <bool> status-error: false;

    callback save();
    callback close-window();

    VerticalLayout {
        ScrollView {
            VerticalLayout {
                padding: 22px;
                padding-bottom: 8px;
                spacing: 14px;

                Text { text: "Settings"; font-size: 22px; font-weight: 600; color: Palette.t.text; }

                Heading { text: "GENERAL"; }
                Row {
                    label: "Shortcut";
                    note: "e.g. Alt+`, Ctrl+Alt+Space, Win+Shift+W";
                    LineEdit { width: 170px; text <=> root.hotkey; placeholder-text: "Alt+`"; }
                }
                Row {
                    label: "Start with Windows";
                    CheckBox { checked <=> root.startup; }
                }

                Heading { text: "VIEW"; }
                Row {
                    label: "Show apps as";
                    HorizontalLayout {
                        spacing: 6px;
                        Button { text: "Icons"; primary: !root.previews; clicked => { root.previews = false; } }
                        Button { text: "Live previews"; primary: root.previews; clicked => { root.previews = true; } }
                    }
                }
                Row {
                    label: "Windows";
                    note: root.one-desktop ? "Every window in one grid (for one desktop with lots of windows)"
                                           : "A tile for each desktop";
                    HorizontalLayout {
                        spacing: 6px;
                        Button { text: "Per desktop"; primary: !root.one-desktop; clicked => { root.one-desktop = false; } }
                        Button { text: "One grid"; primary: root.one-desktop; clicked => { root.one-desktop = true; } }
                    }
                }
                Row {
                    label: "Search";
                    note: root.search-mode == "hide" ? "Windows that don't match are hidden"
                        : root.search-mode == "top" ? "Matching windows move to the front"
                        : "Windows that don't match are faded";
                    HorizontalLayout {
                        spacing: 6px;
                        Button { text: "Fade"; primary: root.search-mode == "dim"; clicked => { root.search-mode = "dim"; } }
                        Button { text: "Hide"; primary: root.search-mode == "hide"; clicked => { root.search-mode = "hide"; } }
                        Button { text: "To front"; primary: root.search-mode == "top"; clicked => { root.search-mode = "top"; } }
                    }
                }
                Row {
                    label: "Preview on hover";
                    note: "Icons view: hover an app to see it live";
                    CheckBox { checked <=> root.hover-preview; enabled: !root.previews; }
                }
                Row {
                    label: "Placement";
                    note: root.free-layout ? "Widgets float in capsules you can put anywhere"
                                           : "Widgets sit inside the panel";
                    HorizontalLayout {
                        spacing: 6px;
                        Button { text: "Fixed"; primary: !root.free-layout; clicked => { root.free-layout = false; } }
                        Button { text: "Free"; primary: root.free-layout; clicked => { root.free-layout = true; } }
                    }
                }
                Row {
                    label: "Arrangement";
                    note: root.vertical
                        ? (root.free-layout ? "Desktops stacked in a column" : "Desktops stacked, widgets beside them")
                        : (root.free-layout ? "Desktops side by side" : "Desktops side by side, widgets under them");
                    HorizontalLayout {
                        spacing: 6px;
                        Button { text: "Row"; primary: !root.vertical; clicked => { root.vertical = false; } }
                        Button { text: "Column"; primary: root.vertical; clicked => { root.vertical = true; } }
                    }
                }
                Row {
                    label: "Position on screen";
                    note: root.custom-position ? "You placed it yourself" : "Centred near the top";
                    HorizontalLayout {
                        spacing: 6px;
                        if root.custom-position: Button { text: "Reset"; clicked => { root.reset-position(); } }
                        Button { text: "Move\u{2026}"; clicked => { root.edit-on-screen(); } }
                    }
                }
                if !root.one-desktop: Row {
                    label: "Desktops per row";
                    SpinBox { width: 120px; minimum: 1; maximum: 10; value <=> root.per-row; }
                }
                Row {
                    label: "Distance from the top";
                    note: root.top-margin + "% of the screen height";
                    Slider { width: 170px; minimum: 0; maximum: 40; value: root.top-margin;
                             changed(v) => { root.top-margin = round(v); } }
                }
                Row {
                    label: "Open on the monitor with the mouse";
                    CheckBox { checked <=> root.mouse-monitor; }
                }

                Heading { text: "WIDGETS"; }
                Row {
                    label: "Show";
                    VerticalLayout {
                        spacing: 6px;
                        HorizontalLayout {
                            spacing: 8px;
                            CheckBox { text: "Notes"; checked: root.flags.notes; toggled => { root.flags.notes = self.checked; } }
                            CheckBox { text: "Music"; checked: root.flags.music; toggled => { root.flags.music = self.checked; } }
                            CheckBox { text: "Timer"; checked: root.flags.timer; toggled => { root.flags.timer = self.checked; } }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            CheckBox { text: "Weather"; checked: root.flags.weather; toggled => { root.flags.weather = self.checked; } }
                            CheckBox { text: "Calendar"; checked: root.flags.calendar; toggled => { root.flags.calendar = self.checked; } }
                        }
                    }
                }
                Row {
                    label: "Widget size";
                    HorizontalLayout {
                        spacing: 6px;
                        Button { text: "S"; primary: root.widget-size == "small"; clicked => { root.widget-size = "small"; } }
                        Button { text: "M"; primary: root.widget-size == "medium"; clicked => { root.widget-size = "medium"; } }
                        Button { text: "L"; primary: root.widget-size == "large"; clicked => { root.widget-size = "large"; } }
                    }
                }
                if !root.free-layout: Row {
                    label: root.vertical ? "Widgets on the left" : "Widgets above the desktops";
                    CheckBox { checked <=> root.widgets-first; }
                }
                Row {
                    label: "Weather city";
                    note: "e.g. Mumbai, London, New York";
                    LineEdit { width: 170px; text <=> root.city; placeholder-text: "City"; }
                }
                Row {
                    label: "Fahrenheit (\u{00B0}F)";
                    CheckBox { checked <=> root.fahrenheit; }
                }

                Heading { text: "PRIVACY"; }
                Row {
                    label: "Privacy mode";
                    note: "Ticked apps show only their icon: no preview and no window title. Tip: right-click an app in the overview to tick it.";
                    CheckBox { checked <=> root.privacy; }
                }
                if root.privacy && root.privacy-apps.length == 0: Text {
                    text: "Open some apps, then come back here to pick them.";
                    color: Palette.t.faint; font-size: 12px;
                }
                if root.privacy: VerticalLayout {
                    spacing: 2px;
                    for app[i] in root.privacy-apps: Rectangle {
                        height: 34px;
                        border-radius: 6px;
                        background: row-ta.has-hover ? Palette.t.cell-hover : transparent;
                        row-ta := TouchArea { clicked => { root.privacy-toggle(i, !app.on); } }
                        HorizontalLayout {
                            padding-left: 8px; padding-right: 8px;
                            spacing: 10px;
                            Image { source: app.icon; width: 20px; height: 20px; y: 7px; }
                            Text { text: app.name; color: Palette.t.text; font-size: 13px; vertical-alignment: center;
                                   horizontal-stretch: 1; min-width: 200px; }
                            CheckBox { checked: app.on; toggled => { root.privacy-toggle(i, self.checked); } }
                        }
                    }
                }

                Heading { text: "LOOK"; }
                Text { text: "Theme"; font-size: 14px; color: Palette.t.text; }
                Rectangle {
                    height: ceil(root.themes.length / 4) * 74px;
                    for t[i] in root.themes: Rectangle {
                        property <bool> chosen: t.name == root.theme;
                        x: mod(i, 4) * (parent.width / 4);
                        y: floor(i / 4) * 74px;
                        width: parent.width / 4 - 8px; height: 66px;
                        border-radius: 10px;
                        background: t.panel;
                        border-width: self.chosen ? 2.5px : 1px;
                        border-color: self.chosen ? root.accent : Palette.t.border;
                        Rectangle {
                            x: 8px; y: 8px; width: parent.width - 16px; height: 26px;
                            border-radius: 6px; background: t.tile;
                            Rectangle { x: 6px; y: 8px; width: 10px; height: 10px; border-radius: 5px; background: root.accent; }
                            Rectangle { x: 22px; y: 8px; width: 10px; height: 10px; border-radius: 3px; background: t.text.with-alpha(0.5); }
                        }
                        Text { x: 8px; y: 40px; text: t.name; color: t.text; font-size: 11px; }
                        TouchArea { mouse-cursor: pointer; clicked => { root.theme = t.name; root.theme-picked(t.name); } }
                    }
                }
                Row {
                    label: "Accent colour";
                    HorizontalLayout {
                        spacing: 8px;
                        for c in [#8ab4f8, #a78bfa, #f472b6, #fb923c, #facc15, #34d399, #e5e7eb]: Rectangle {
                            width: 24px; height: 24px; border-radius: 12px;
                            background: c;
                            border-width: root.accent == c ? 3px : 0px;
                            border-color: Palette.t.text;
                            TouchArea { mouse-cursor: pointer; clicked => { root.accent = c; } }
                        }
                    }
                }

                Heading { text: "ABOUT"; }
                Row {
                    label: "WinOverview v" + root.version;
                    note: root.update-status;
                    HorizontalLayout {
                        spacing: 6px;
                        if root.update-ready: Button { text: "Update now"; primary: true; clicked => { root.install-update(); } }
                        if root.update-failed: Button { text: "Release page"; clicked => { root.open-release(); } }
                        if !root.update-ready: Button { text: "Check for updates"; clicked => { root.check-updates(); } }
                    }
                }
                if root.update-notes != "": Rectangle {
                    border-radius: 8px;
                    background: Palette.t.cell;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 4px;
                        Text { text: "What's new"; font-size: 12px; font-weight: 600; color: Palette.t.text; }
                        Text { text: root.update-notes; font-size: 12px; color: Palette.t.text; wrap: word-wrap; }
                    }
                }
            }
        }

        HorizontalLayout {
            padding: 16px;
            padding-top: 10px;
            spacing: 10px;
            Text {
                horizontal-stretch: 1;
                text: root.status;
                color: root.status-error ? (Palette.t.dark ? #ff8a8a : #c42b2b) : (Palette.t.dark ? #9be3a6 : #1f7a35);
                vertical-alignment: center;
                wrap: word-wrap;
            }
            Button { text: "Close"; clicked => { root.close-window(); } }
            Button { text: "Save"; primary: true; clicked => { root.save(); } }
        }
    }
}
